# APRS V6 Pro - Environment Configuration
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA NIM API Keys (3-key cluster = 3,000 req/day, 30M tokens/day)
# Get keys at: https://integrate.api.nvidia.com
# ─────────────────────────────────────────────────────────────────────────────
NIM_API_KEY_1=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
NIM_API_KEY_2=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
NIM_API_KEY_3=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

# ─────────────────────────────────────────────────────────────────────────────
# Keepa API (for BSR/Price history - optional but recommended)
# Get key at: https://keepa.com/#!api
# ─────────────────────────────────────────────────────────────────────────────
KEEPA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Local LLM (Ollama / llama.cpp / LM Studio) - Fallback when NIM exhausted
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LOCAL_QWEN_27B_MODEL=qwen2.5:27b-instruct-q4_K_M
LOCAL_QWEN_05B_MODEL=qwen2.5:0.5b-instruct-q4_K_M
# LOCAL_KIMI_MODEL=kimi-k3  # After building llama.cpp wrapper

# ─────────────────────────────────────────────────────────────────────────────
# Browser-Use Cloud (Production: anti-bot, captcha bypass, global proxies)
# Get API key at: https://cloud.browser-use.com/new-api-key
# ─────────────────────────────────────────────────────────────────────────────
BROWSER_USE_API_KEY=
# BROWSER_USE_CLOUD_PROFILE_ID=your-profile-id  # Optional: pre-authenticated profile
# BROWSER_USE_PROXY_COUNTRY=us  # Optional: us, uk, fr, it, jp, au, de, fi, ca, in

# ─────────────────────────────────────────────────────────────────────────────
# Self-Hosted Proxy Pool (Alternative to browser-use cloud)
# ─────────────────────────────────────────────────────────────────────────────
# PROXY_ENABLED=true
# PROXY_BUDGET_DAILY_USD=5.00
# PROXY_PROVIDER_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# ─────────────────────────────────────────────────────────────────────────────
# Database (auto-created, override for testing)
# ─────────────────────────────────────────────────────────────────────────────
# APRS_DB_PATH=D:/ecomm-strategy/data/research_engine.db

# ─────────────────────────────────────────────────────────────────────────────
# LLM Routing (which provider for which task)
# Options: nim, ollama, openai, anthropic, google
# ─────────────────────────────────────────────────────────────────────────────
# LLM_ROUTING_SCOUT=nim,ollama
# LLM_ROUTING_HARVESTER=nim,ollama
# LLM_ROUTING_DEFECT_MINER=nim,ollama
# LLM_ROUTING_ECONOMICS=nim,ollama
# LLM_ROUTING_ARBITER=nim  # Never fallback for final verdict

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Other LLM Providers (for local fallback routing)
# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Meta Ads / Social APIs (for trend discovery - optional)
# ─────────────────────────────────────────────────────────────────────────────
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# TIKTOK_API_KEY=
# YOUTUBE_API_KEY=
LOCAL_OLLAMA_MODEL=qwen27b_iq1
LOCAL_QWEN_27B_PATH=F:\Yuki_1.0\data\models\Qwen3.8-27B-UD-IQ1_S.gguf