# APRS V6 Pro — Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database path (relative to project root)
APRS_DB_PATH=data/research_engine.db
EXCEL_MASTER_PATH=APRS_Master_Product_Intelligence.xlsx

# =============================================================================
# KEEPA API (Required for BSR/price history)
# Get your API key from https://keepa.com/#!api
# =============================================================================
KEEPA_API_KEY=your_keepa_api_key_here

# =============================================================================
# OLLAMA (Local LLM for defect extraction - ONE call per product)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull qwen2.5:14b
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_TEMPERATURE=0.2

# =============================================================================
# PLAYWRIGHT SCRAPING (Anti-detection)
# =============================================================================
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCRAPER_DELAY_MS=2000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# BATCH EXECUTION (No daemons - cron or manual triggers only)
# =============================================================================
BATCH_NICHE_LIMIT=5
BATCH_MAX_CANDIDATES=3
BATCH_MAX_PAGES=2

# =============================================================================
# GATE THRESHOLDS (4-Gate System)
# =============================================================================
# Gate 1: Keepa BSR Signal
GATE1_BSR_THRESHOLD=50000
GATE1_CV_THRESHOLD=0.30

# Gate 3: Economics (15-factor, 3-scenario)
GATE3_MIN_MARGIN_PCT=20.0

# Gate 4: Deterministic Scoring (0-100)
GATE4_MIN_SCORE=75

# =============================================================================
# REGIONAL SETTINGS (India-first)
# =============================================================================
DEFAULT_REGION=India
TARGET_AOV_MIN_INR=799
TARGET_AOV_MAX_INR=2499
SWEET_SPOT_MSRP_INR=1299
DEFAULT_COD_PCT=0.35
DEFAULT_RTO_PCT=0.18
PLATFORM_FEE_PCT=0.05

# Sourcing hubs (comma-separated)
SOURCING_HUBS=Tirupur (Textiles),Surat (Apparel/Jewelry),Moradabad (Brass/Home),Jaipur (Handicrafts),Shenzhen (Electronics),Yiwu (Small Goods)

# Target marketplaces (comma-separated)
MARKETPLACES=Amazon IN,Flipkart,Meesho,Myntra

# =============================================================================
# SCORING WEIGHTS (Deterministic 0-100 rubric)
# =============================================================================
SCORE_MARKET_SIGNAL_WEIGHT=25
SCORE_REVIEW_QUALITY_WEIGHT=20
SCORE_MARGIN_SAFETY_WEIGHT=40
SCORE_DEFECT_FIXABILITY_WEIGHT=10
SCORE_COMPETITION_DENSITY_WEIGHT=5

SCORE_PROCEED_THRESHOLD=75
SCORE_MARGINAL_THRESHOLD=60